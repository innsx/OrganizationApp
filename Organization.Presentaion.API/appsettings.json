  //NOTE: we needed to DECLARE CONNECTIONSTRING IN ORDER FOR US TO REFERENCE IN WRITETO MSSqlServer SINKS
  "ConnectionStrings": {
    "SqlConnection": "Server=DESKTOP-KQ86VHG\\SQLEXPRESS;Database=OrganizationDb3;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Encrypt=false;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.MSSqlServer",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Environment"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    //enricher is a Serilog feature that empowers us to dynamically include valuable contextual properties in our log entries
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console" //write to the Console
      },
      {
        "Name": "File", //write to a File
        "Args": {
          "path": "%APPDATA%\\Organization.Application\\Logs\\Log-.txt", //path to Text File  & log in JSON format
          "rollingInterval": "Day",
          "rollingSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File", //write to another File
        "Args": {
          "path": "%APPDATA%\\Organization.Application\\Logs\\Log.json", //path to file & log in JSON format
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
      //,
      //{
      //  "Name": "MSSqlServer",
      //  "Args": {
      //    "connectionString": "SqlConnection",
      //    "sinkOptionsSection": {
      //      "tableName": "Organization.Application.Logs",
      //      "autoCreateSqlTable": true
      //    },
      //    "restrictedToMinimumLevel": "Warning"
      //  }
      //}
    ]
  },
  "AllowedHosts": "*"
}
